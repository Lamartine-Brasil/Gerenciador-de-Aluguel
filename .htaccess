# Cabeçalhos de proteção para o sistema inteiro (Apache).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
<FilesMatch "\.html?$">
    <IfModule mod_headers.c>
        # A mesma política do <meta> do index.html, mais o frame-ancestors (que só
        # vale como cabeçalho): ninguém consegue embutir o sistema em outro site.
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </IfModule>
</FilesMatch>

# Arquivos de desenvolvimento e documentação interna não precisam ficar
# acessíveis pela URL.
<FilesMatch "^(agents\.md|etapas\.txt|README\.md|roteador-dev\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
RedirectMatch 404 ^.*/(tests|docs|\.git)(/.*)?$
